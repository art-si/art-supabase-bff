{
  "name": "art-supabase-bff",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.21.0",
    "pnpm": ">=11.28.2"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=vite.config.ts --use-env-proxy --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --use-env-proxy --import tsx server/index.ts --production",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "lint": "eslint src server tests vite.config.ts",
    "clean:local": "powershell.exe -NoProfile -File scripts/clean-local-artifacts.ps1",
    "icons:generate": "tsx scripts/generate-offline-icons.ts",
    "icons:check": "tsx scripts/generate-offline-icons.ts --check"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.10.3",
