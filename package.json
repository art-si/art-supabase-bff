{
  "name": "art-supabase-bff",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.21.0",
    "pnpm": ">=11.28.2"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=vite.config.ts --use-env-proxy --import tsx server/index.ts",
    "build": "vite build",
    "start": "node --use-env-proxy --import tsx server/index.ts --production",
    "typecheck": "tsx vite.config.ts --typecheck",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "ui:audit": "tsx node_modules/art-supabase-pro/scripts/ui-audit.ts",
    "lint": "eslint src server tests vite.config.ts",
    "clean:local": "powershell.exe -NoProfile -File scripts/clean-local-artifacts.ps1",
    "boundary:audit": "node node_modules/art-supabase-pro/scripts/platform-consumer.mjs",
    "skills:link": "node node_modules/art-supabase-pro/scripts/platform-consumer.mjs --link-skills",
    "postinstall": "npm run skills:link",
    "stylelint": "stylelint \"src/**/*.vue\"",
    "check": "npm run boundary:audit && npm run typecheck && npm run lint && npm run stylelint && npm run ui:audit && npm run test:unit"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "art-supabase-pro": "https://gitee.com/art-si/art-supabase-pro/repository/archive/c851871d1eb2d06a8bec2cb007e8df990471f28b.tar.gz",
    "openid-client": "6.8.9",
    "lodash-es": "^4.18.1",
    "@supabase/supabase-js": "^2.117.3",
    "jose": "6.2.15",
    "vue-router": "^5.4.0",
    "element-plus": "^2.14.7",
    "pinia": "4.0.3",
    "@element-plus/icons-vue": "^2.3.2",
    "vue": "^3.5.43",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "stylelint-config-html": "^2.0.0",
    "@playwright/test": "^1.64.0",
    "stylelint": "^17.16.0",
    "eslint-config-prettier": "^10.1.8",
    "unplugin-vue-components": "^32.1.0",
    "typescript-eslint": "^8.71.1",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^6.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "unplugin-element-plus": "^0.11.2",
    "vue-tsc": "~3.3.13",
    "eslint-plugin-prettier": "^5.5.6",
    "stylelint-config-standard": "^40.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "stylelint-config-recess-order": "^7.8.0",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "vite": "^8.3.4",
    "eslint": "^10.12.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "unplugin-auto-import": "^21.1.0",
    "tsx": "^4.23.15",
    "postcss-scss": "^4.0.9",
    "@types/node": "^26.6.5",
    "stylelint-config-recommended-scss": "^17.0.1",
    "prettier": "^3.9.10",
    "@vue/compiler-sfc": "^3.5.43",
    "@eslint/js": "^10.0.1",
    "sass-embedded": "^1.105.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "typescript": "~6.0.3"
  },
  "description": "统一认证与应用管理 BFF 平台，复用 art-supabase-pro 主仓组件体系",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/art-si/art-supabase-bff.git"
  },
  "keywords": [
    "bff",
    "supabase",
    "vue3"
  ],
  "author": "",
  "license": "ISC",
  "private": true
}
