# Node server settings. Keep secrets out of VITE_ variables.
BFF_PORT=3010
BFF_ORIGIN=http://localhost:3010
BFF_AUTH_ISSUER=https://ckbftoopuyophiebamwy.supabase.co/auth/v1
BFF_AUTH_UI_URL=https://art-si.github.io/art-supabase-pro/#/auth/oauth-consent
BFF_AUTH_CLIENT_ID=
BFF_AUTH_CLIENT_SECRET=
BFF_SESSION_KEY=
BFF_SUPABASE_URL=https://bksbwnxdurmuolygiofh.supabase.co
BFF_SUPABASE_SERVICE_KEY=

# Independent, versioned 32-byte Base64 encryption keys for upstream credentials.
# Keep previous keys while records still use them. Never commit actual values.
BFF_CREDENTIAL_KEY_ID=v1
BFF_CREDENTIAL_KEYS={}

# Exact origins, comma-separated; empty means no external requests are allowed.
BFF_UPSTREAM_ALLOWED_ORIGINS=
# Optional trusted internal network CIDRs; link-local/metadata remain blocked.
BFF_UPSTREAM_ALLOWED_CIDRS=
# Controlled local development only. Always false in production.
BFF_UPSTREAM_ALLOW_LOCAL_HTTP=false
# Non-GET draft tests: development/staging sandbox origins only, also in allowed origins.
# Production draft tests always remain GET-only.
BFF_INTERFACE_TEST_WRITE_ORIGINS=
