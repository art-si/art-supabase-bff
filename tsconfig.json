{
  "compilerOptions": {
    "target": "esnext", "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "jsx": "preserve", "jsxImportSource": "vue",
    "resolveJsonModule": true, "esModuleInterop": true,
    "lib": ["esnext", "dom"], "types": ["vite/client", "node", "element-plus/global"],
    "skipLibCheck": true, "ignoreDeprecations": "6.0", "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@views/*": ["src/views/*"], "@imgs/*": ["src/assets/images/*"], "@icons/*": ["src/assets/icons/*"], "@utils/*": ["src/utils/*"], "@stores/*": ["src/store/*"], "@plugins/*": ["src/plugins/*"], "@styles/*": ["src/assets/styles/*"] }
  },
  "include": ["src/**/*", "server/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/types/import/components.d.ts"]
}
