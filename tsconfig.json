{
  "extends": "./node_modules/art-supabase-pro/tsconfig.consumer.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@bff/*": ["src/*"],
      "@/router": ["src/router/index.ts"],
      "@/router/index": ["src/router/index.ts"],
      "@/*": ["node_modules/art-supabase-pro/src/*"],
      "@views/*": ["node_modules/art-supabase-pro/src/views/*"],
      "@styles/*": ["node_modules/art-supabase-pro/src/assets/styles/*"],
      "@imgs/*": ["node_modules/art-supabase-pro/src/assets/images/*"],
      "@utils/*": ["node_modules/art-supabase-pro/src/utils/*"],
      "@stores/*": ["node_modules/art-supabase-pro/src/store/*"],
      "@/router/core/platform-route-modules": [
        "node_modules/art-supabase-pro/src/router/core/standalone-route-modules.ts"
      ]
    }
  },
  "include": ["src/**/*", "server/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
